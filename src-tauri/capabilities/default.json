{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "cors-fetch:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:8080/**" },
        { "url": "http://*:9000/**" },
        { "url": "http://localhost:8080/**" },
        { "url": "http://127.0.0.1:8080/**" }
      ],
      "deny": []
    },
    "http:allow-fetch",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send"
  ]
}
