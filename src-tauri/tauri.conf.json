{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CAVI",
  "version": "0.1.0",
  "identifier": "com.cavi.calculator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "http": {
      "enabled": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CAVI Калькулятор",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://*:9000 data: blob:; connect-src 'self' http://*:8080 http://*:9000; script-src 'self'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
